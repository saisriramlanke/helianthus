{
  "name": "helianthic-core",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "live-check": "tsc && node lib/live-check.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-helianthic \"vitest run --config vitest.rules.config.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.3",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
